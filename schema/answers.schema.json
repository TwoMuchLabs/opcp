{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opcp:schema:0.1:answers",
  "title": "OPCP answers file",
  "description": "Answers to an OPCP question bank, by question ID, with the evidence behind each.",
  "type": "object",
  "required": ["answers_version", "bank", "bank_version", "organisation", "processes"],
  "additionalProperties": false,
  "properties": {
    "answers_version": {"const": "0.1"},
    "bank": {"type": "string"},
    "bank_version": {"type": "string"},
    "organisation": {"type": "string", "minLength": 1},
    "assessment_date": {"type": "string", "format": "date"},
    "prepared_by": {"$ref": "#/$defs/person"},
    "reviewed_by": {"$ref": "#/$defs/person"},
    "settings": {"type": "object"},
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "supplier", "answers"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "owner": {"type": "string"},
          "supplier": {"type": "string", "minLength": 1},
          "capability": {"type": "string"},
          "archetype": {"enum": ["check", "extract", "generate", "transact", "retrieve", "notify", "human_task"]},
          "notes": {"type": "string"},
          "mappings": {
            "type": "object",
            "description": "Optional references from this process to external process taxonomies, such as an APQC PCF element. Carried into the results; not rated. Same shape as a capability contract's mappings; see docs/TAXONOMIES.md.",
            "additionalProperties": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "#/$defs/mapping"}
              ]
            }
          },
          "answers": {
            "type": "object",
            "propertyNames": {"pattern": "^ERS-[A-Z]{3}-[0-9]{2}$"},
            "additionalProperties": {
              "type": "object",
              "required": ["value"],
              "additionalProperties": false,
              "properties": {
                "value": {},
                "evidence": {"enum": ["declared", "documented", "tested"]},
                "ref": {"type": "string"},
                "answered_by": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "mapping": {
      "description": "A pointer to one item in an external taxonomy (docs/TAXONOMIES.md). Defined identically in the capability, answers and scorecard schemas, so each validates on its own; tests/test_taxonomy_mappings.py keeps the three identical.",
      "type": "object",
      "required": ["ref", "source"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "description": "Identifier or name in the external scheme, such as an APQC PCF element ID or a BIAN service domain name."},
        "source": {"type": "string", "format": "uri", "description": "Where the item can be checked: a link to the item itself, at a fixed release or commit."},
        "version": {"type": "string", "description": "Version or release of the external scheme, such as 8.0 or 14.0.0."},
        "relation": {"enum": ["exact", "closest", "partial"], "description": "How closely this item matches the external one. Read as closest when omitted."},
        "note": {"type": "string"}
      }
    },
    "person": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "role": {"type": "string"}, "date": {"type": "string", "format": "date"}}
    }
  }
}
