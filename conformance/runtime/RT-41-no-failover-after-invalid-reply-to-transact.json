{
  "id": "RT-41-no-failover-after-invalid-reply-to-transact",
  "guarantee": "A transact supplier that replies with output the contract rejects may still have acted, so the runtime does not try another supplier (spec 7.1, 7.2; issue #27).",
  "setup": {
    "today": "2026-11-07",
    "contracts": [
      "post-journal-entry"
    ],
    "suppliers": [
      {
        "adapter_id": "a",
        "supplier_id": "A",
        "capability": "post-journal-entry",
        "behaviour": {
          "respond": {
            "output": {
              "receipt_id": 7,
              "status": "completed",
              "compensation": "post a reversing entry"
            },
            "evidence": [
              {
                "type": "ledger",
                "reference": "gl-1"
              }
            ]
          }
        },
        "max_rclass": "R2",
        "max_data_classification": "internal"
      },
      {
        "adapter_id": "b",
        "supplier_id": "B",
        "capability": "post-journal-entry",
        "behaviour": {
          "respond": {
            "output": {
              "receipt_id": "rcpt-1",
              "status": "completed",
              "compensation": "post a reversing entry"
            },
            "evidence": [
              {
                "type": "ledger",
                "reference": "gl-1"
              }
            ]
          }
        },
        "max_rclass": "R2",
        "max_data_classification": "internal"
      }
    ],
    "routes": [
      {
        "opcp_version": "0.1",
        "capability": "post-journal-entry",
        "version": 1,
        "mode": "pinned",
        "authored_by": "maker",
        "approved_by": "checker",
        "candidates": [
          "a",
          "b"
        ]
      }
    ],
    "gate": {
      "budgets": {
        "post-journal-entry": 5
      }
    }
  },
  "calls": [
    {
      "capability": "post-journal-entry",
      "input": {
        "entry_date": "2026-10-31",
        "currency": "SGD",
        "lines": [
          {
            "account": "6100",
            "debit": 10,
            "credit": 0
          },
          {
            "account": "2100",
            "debit": 0,
            "credit": 10
          }
        ]
      },
      "data_classification": "internal",
      "idempotency_key": "k1",
      "expect": {
        "status": "failed",
        "supplier": "A",
        "rclass": "R2",
        "gate_decision": {
          "allowed": true,
          "rclass": "R2"
        }
      }
    }
  ],
  "expect_final": {
    "received": {
      "a": [
        {
          "entry_date": "2026-10-31",
          "currency": "SGD",
          "lines": [
            {
              "account": "6100",
              "debit": 10,
              "credit": 0
            },
            {
              "account": "2100",
              "debit": 0,
              "credit": 10
            }
          ]
        }
      ],
      "b": []
    }
  }
}
