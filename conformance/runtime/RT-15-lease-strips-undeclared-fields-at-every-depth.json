{
  "id": "RT-15-lease-strips-undeclared-fields-at-every-depth",
  "guarantee": "The supplier receives only fields the contract declares, at every level of nesting (spec 11.2).",
  "setup": {
    "today": "2026-11-07",
    "contracts": [
      "verify-identity"
    ],
    "suppliers": [
      {
        "adapter_id": "a",
        "supplier_id": "A",
        "capability": "verify-identity",
        "behaviour": {
          "respond": {
            "output": {
              "verdict": "pass",
              "reason_codes": []
            },
            "evidence": [
              {
                "type": "report",
                "reference": "r1"
              }
            ],
            "confidence": 0.95
          }
        }
      }
    ],
    "routes": [
      {
        "opcp_version": "0.1",
        "capability": "verify-identity",
        "version": 1,
        "mode": "pinned",
        "authored_by": "maker",
        "approved_by": "checker",
        "candidates": [
          "a"
        ]
      }
    ]
  },
  "calls": [
    {
      "capability": "verify-identity",
      "input": {
        "full_name": "Alex Tan",
        "date_of_birth": "1990-04-12",
        "document": {
          "type": "passport",
          "number": "K1234567",
          "issuing_country": "SG",
          "mrz": "P<SGPTAN<<ALEX"
        },
        "salary": 120000
      },
      "data_classification": "confidential",
      "idempotency_key": "k1",
      "expect": {
        "status": "ok",
        "supplier": "A",
        "rclass": "R0",
        "gate_decision": {
          "allowed": true,
          "rclass": "R0"
        }
      }
    }
  ],
  "expect_final": {
    "received": {
      "a": [
        {
          "full_name": "Alex Tan",
          "date_of_birth": "1990-04-12",
          "document": {
            "type": "passport",
            "number": "K1234567",
            "issuing_country": "SG"
          }
        }
      ]
    }
  }
}
